# ---- API ----
NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/chheda_gold
# Allowed browser origin for the dashboard
WEB_ORIGIN=http://localhost:3000
# 32-byte key (base64) used to encrypt Meta tokens / phone numbers. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Keep true until real Meta credentials are configured
DRY_RUN=true

# ---- First admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@chhedajewellers.com
SEED_ADMIN_PASSWORD=

# ---- Web ----
API_INTERNAL_URL=http://localhost:4000

# ---- Media storage (Phase 2) ----
# local = files under MEDIA_DIR, served by the API at /media (fine for dev / a single VPS)
# s3    = production stub (Phase 7); needs S3_BUCKET + S3_REGION (+ optional S3_PREFIX, S3_PUBLIC_BASE_URL)
STORAGE_DRIVER=local
MEDIA_DIR=./uploads
# Public URL of the API – image links are built from it (Instagram must be able to fetch them). Required in production.
MEDIA_BASE_URL=http://localhost:4000

# ---- Meta / WhatsApp / Instagram (Phase 4) ----
# Keep DRY_RUN=true until everything below is filled in and "Test connection" passes on the Connections page.
# Graph API version used for every Instagram + WhatsApp call (one place only).
META_GRAPH_VERSION=v21.0
# Meta app id + secret (Meta for Developers → your app → App settings → Basic). The secret signs webhooks (X-Hub-Signature-256).
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the webhook "Verify token" field in the Meta app dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp batch sending: parallel requests + pause between them (stay well under the Cloud API rate limits).
WA_SEND_CONCURRENCY=5
WA_SEND_DELAY_MS=100
# How long to wait for an Instagram media container to finish processing before giving up (ms).
IG_PUBLISH_TIMEOUT_MS=120000
# Access tokens, IG user id, WABA id and phone number id are NOT env vars: enter them on Settings → Connections
# (stored AES-256-GCM encrypted with ENCRYPTION_KEY). Template name + language live in Settings.

# /etc/systemd/system/chheda-api.service
[Unit]
Description=Chheda Gold Rate – API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chheda
WorkingDirectory=/opt/chheda/app
EnvironmentFile=/opt/chheda/app/.env
Environment=NODE_ENV=production
ExecStartPre=/usr/bin/node apps/api/scripts/check-env.mjs /opt/chheda/app/.env
ExecStart=/usr/bin/npx tsx apps/api/src/server.ts
Restart=always
RestartSec=5
StandardOutput=append:/var/log/chheda/api.log
StandardError=append:/var/log/chheda/api.log
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/chheda/app/uploads /var/log/chheda

[Install]
WantedBy=multi-user.target

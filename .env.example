# ---- API ----
NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/chheda_gold
# Allowed browser origin for the dashboard
WEB_ORIGIN=http://localhost:3000
# 32-byte key (base64) used to encrypt Meta tokens / phone numbers. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Keep true until real Meta credentials are configured
DRY_RUN=true

# ---- First admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@chhedajewellers.com
SEED_ADMIN_PASSWORD=

# ---- Web ----
API_INTERNAL_URL=http://localhost:4000

# ---- Media storage (Phase 2) ----
# local = files under MEDIA_DIR, served by the API at /media (fine for dev / a single VPS)
# s3    = production stub (Phase 7); needs S3_BUCKET + S3_REGION (+ optional S3_PREFIX, S3_PUBLIC_BASE_URL)
STORAGE_DRIVER=local
MEDIA_DIR=./uploads
# Public URL of the API – image links are built from it (Instagram must be able to fetch them). Required in production.
MEDIA_BASE_URL=http://localhost:4000

# ---- Meta / WhatsApp / Instagram (Phase 4) ----
# Keep DRY_RUN=true until everything below is filled in and "Test connection" passes on the Connections page.
# Graph API version used for every Instagram + WhatsApp call (one place only).
META_GRAPH_VERSION=v21.0
# Meta app id + secret (Meta for Developers → your app → App settings → Basic). The secret signs webhooks (X-Hub-Signature-256).
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the webhook "Verify token" field in the Meta app dashboard.
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp batch sending: parallel requests + pause between them (stay well under the Cloud API rate limits).
WA_SEND_CONCURRENCY=5
WA_SEND_DELAY_MS=100
# How long to wait for an Instagram media container to finish processing before giving up (ms).
IG_PUBLISH_TIMEOUT_MS=120000
# Access tokens, IG user id, WABA id and phone number id are NOT env vars: enter them on Settings → Connections
# (stored AES-256-GCM encrypted with ENCRYPTION_KEY). Template name + language live in Settings.

# ---- Staff push notifications + admin alert emails (Phase 4B) ----
# Web push (staff app): generate once with `npx web-push generate-vapid-keys` and paste both keys. Subject = contact mailto: or https URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@chhedajewellers.com
# Public URL of the dashboard (links in push notifications + alert emails)
WEB_PUBLIC_URL=http://localhost:3000
# SMTP for admin alert emails (any provider: Gmail app password, SES, Brevo…). Leave SMTP_HOST empty to disable email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chheda Gold Rate <alerts@chhedajewellers.com>"
# Admin alert recipients (emails + WhatsApp numbers) and the reminder delay are set in the dashboard → Settings.

# ---- "RATE" keyword auto-reply (Phase 5) ----
# No new env vars: trigger words, per-sender limit and the "not ready" text live in Settings; replies use the WhatsApp / Instagram
# connections from Settings → Connections. Instagram DMs need the `instagram_manage_messages` permission and the Instagram
# webhook field `messages` subscribed to /api/v1/webhooks/instagram.

# ---- Production storage: Cloudinary (Phase 7) ----
# STORAGE_DRIVER=cloudinary in production (images get a CDN URL Instagram can fetch). Keys: Cloudinary console → Settings → API keys.
# STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chheda

# ---- Observability (Phase 7) ----
# Sentry project DSNs (Node for api+worker, a browser/Next project for the dashboard). Empty = disabled.
SENTRY_DSN=
# Release tag – deploy.sh writes the git sha to .env.version; CI/Docker pass APP_VERSION as a build arg
APP_VERSION=
# Worker health endpoint (GET /health, GET /ready) for systemd / uptime monitors
WORKER_PORT=4100

# ---- Vercel (dashboard) – set these in the Vercel project, not here ----
# API_INTERNAL_URL=https://api.chhedajewellers.com   (server-side rewrite target)
# NEXT_PUBLIC_SENTRY_DSN=   NEXT_PUBLIC_APP_VERSION=

# ---- Local development convenience (NEVER in production – the API refuses to start) ----
# API: skip the login screen and act as this user for every request without a session
# DEV_AUTO_LOGIN_EMAIL=admin@chhedajewellers.com
# Web: also skip the login redirect in the dashboard
# DEV_AUTO_LOGIN=1

# ---- IBJA benchmark rates (24K = 999, 22K = 916, 18K = 750; per-10g ÷ 10 exactly, never rounded) ----
# website = parse the public ibjarates.com page (fine for the trial). For live pricing IBJA asks you to subscribe to the
# official API (https://www.indiagoldratesapi.com – email nagaraj.iyer@ibja.in): then IBJA_SOURCE=api + IBJA_API_TOKEN.
IBJA_SOURCE=website
IBJA_API_TOKEN=
IBJA_API_BASE=https://ibjarates.com
# Fetch times, auto-draft (creates tomorrow's draft after each fetch) and auto-approve are set in the dashboard → Settings → IBJA.
